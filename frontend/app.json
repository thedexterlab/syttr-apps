      "EXPO_PUBLIC_STRIPE_FAMILY_SUBSCRIPTION_PRODUCT_ID": "prod_TqWQIH7TaxfKUj",
      "EXPO_PUBLIC_STRIPE_FAMILY_SUBSCRIPTION_PRICE_ID": "price_1TosiPRwD0vhMuRXH8BBQfi8",
      "EXPO_PUBLIC_STRIPE_DESTINATION_ID": "we_1Tot9QRwD0vhMuRXRvjzHlOs",
      "router": {},
      "eas": {
        "projectId": "eaa8526a-f809-42c4-8ed6-56d460062323"
      }
    }
  }
}
